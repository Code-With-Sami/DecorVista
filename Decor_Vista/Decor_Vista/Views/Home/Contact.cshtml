@{
    ViewData["Title"] = "Contact Us - Decor Vista";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* --- Custom Color Theme & Variables --- */
    :root {
        --brand-yellow: #ebcd1e;
        --brand-black: #333;
        --brand-yellow-hover: #d4b91a;
        --light-grey-bg: #f8f9fa;
    }

    /* --- General Section Styling --- */
    .section-contact-us {
        background-color: var(--light-grey-bg);
        padding: 80px 0;
    }

    /* --- Modern Card Styling --- */
    .contact-card {
        background: #ffffff;
        padding: 40px;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        height: 100%;
    }

        .contact-card h3.text-cap {
            font-size: 28px;
            font-weight: 600;
            color: var(--brand-black);
            margin-bottom: 30px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--brand-yellow);
            display: inline-block;
        }

    /* --- Contact Form Styling --- */
    .form-contact-arc .form-control:focus {
        border-color: var(--brand-yellow);
        box-shadow: 0 0 0 0.2rem rgba(235, 205, 30, 0.25);
    }

    .btn-submit.btn-main-color {
        background-color: var(--brand-yellow) !important;
        color: var(--brand-black) !important;
        font-weight: bold;
        border: none;
        padding: 12px 30px;
        transition: background-color 0.3s ease;
    }

        .btn-submit.btn-main-color:hover {
            background-color: var(--brand-yellow-hover) !important;
        }

    /* --- Contact Info Styling --- */
    .info-block {
        display: flex;
        align-items: flex-start;
        margin-bottom: 25px;
    }

    .info-icon {
        font-size: 24px;
        color: var(--brand-yellow);
        margin-right: 20px;
        width: 30px;
    }

    .info-content .info-title {
        font-weight: 600;
        color: var(--brand-black);
        margin-bottom: 5px;
    }

    .info-content .info-text {
        color: #555;
        margin-bottom: 0;
    }

    /* --- Full-Width Map Container --- */
    .map-container-full-width {
        width: 100%;
        /* The height is set directly on the iframe */
    }

        .map-container-full-width iframe {
            display: block; /* Removes any extra space below the iframe */
            border: 0;
            width: 100%;
            height: 450px;
        }

    .ot-btn.btn-main-color.btn-long.text-cap.btn-submit {
        background-color: #f1c40f; /* Yellow */
        color: #000; /* Black text */
        padding: 12px 25px;
        font-size: 16px;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        border: none;
        cursor: pointer;
        display: inline-block; /* Ensure button behaves like a box */
        text-align: center; /* Center text horizontally */
    }

    .ot-btn.btn-main-color.btn-long.text-cap.btn-submit {
        display: flex;
        align-items: center; /* Vertically center */
        justify-content: center; /* Horizontally center */
    }
</style>

<!-- Section Sub Header -->
<section>
    <div class="sub-header sub-header-1 sub-header-contact fake-position">
        <div class="sub-header-content">
            <h2 class="text-cap white-text">Contact Us</h2>
            <ol class="breadcrumb breadcrumb-arc text-cap">
                <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                <li class="active" style="color: var(--brand-yellow);">Contact Us</li>
            </ol>
        </div>
    </div>
</section>
<!-- End Section Sub Header -->
<!-- Section form contact -->
<section class="section-contact-us">
    <div class="container">
        @if (TempData["success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                @TempData["error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        <div class="row">
            <!-- Left Column: Contact Form Card -->
            <div class="col-lg-7 mb-4 mb-lg-0">
                <div class="contact-card">
                    <h3 class="text-cap">Send Us a Message</h3>
                    <form class="form-contact-arc" method="post" asp-action="Submit" asp-controller="Contact">
                        @Html.AntiForgeryToken()
                        <div class="row">
                            <div class="form-group col-sm-6 mb-3"><input type="text" class="form-control" name="Name" placeholder="Your Name" required></div>
                            <div class="form-group col-sm-6 mb-3"><input type="email" class="form-control" name="Email" placeholder="Your Email" required></div>
                        </div>
                        <div class="form-group mb-3"><input type="text" class="form-control" name="PhoneNumber" placeholder="Phone Number (Optional)"></div>
                        <div class="form-group mb-3"><textarea class="form-control" name="Message" rows="5" placeholder="Your Message" required></textarea></div>
                        <button class="ot-btn btn-main-color btn-long text-cap btn-submit">Send Message</button>
                    </form>
                </div>
            </div>

            <!-- Right Column: Contact Info Card -->
            <div class="col-lg-5">
                <div class="contact-card">
                    <h3 class="text-cap">Contact Info</h3>
                    <div class="info-block">
                        <div class="info-icon"><i class="fa fa-home"></i></div>
                        <div class="info-content"><p class="info-title">Our Address</p><p class="info-text">8th floor, 379 Hudson St, New York, NY 10018</p></div>
                    </div>
                    <div class="info-block">
                        <div class="info-icon"><i class="fa fa-phone"></i></div>
                        <div class="info-content"><p class="info-title">Call Us</p><p class="info-text">(+1) 96 716 6879</p></div>
                    </div>
                    <div class="info-block">
                        <div class="info-icon"><i class="fa fa-envelope-o"></i></div>
                        <div class="info-content"><p class="info-title">Email Us</p><p class="info-text">contact@decorvista.com</p></div>
                    </div>
                    <div class="info-block">
                        <div class="info-icon"><i class="fa fa-clock-o"></i></div>
                        <div class="info-content"><p class="info-title">Opening Hours</p><p class="info-text">Mon - Fri: 09:00 - 17:00</p></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
<!-- End Section -->
<!-- Section Google Map - FULL WIDTH -->
<div class="map-container-full-width">
    <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3022.622959827216!2d-74.00881958459395!3d40.7483869793279!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x89c259bf6e851483%3A0x8bef1b6727712362!2s379%20Hudson%20St%2C%20New%20York%2C%20NY%2010014%2C%20USA!5e0!3m2!1sen!2sin!4v1633333333333!5m2!1sen!2sin"
            allowfullscreen=""
            loading="lazy">
    </iframe>
</div>
<!-- End Section -->