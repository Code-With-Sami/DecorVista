@model Decor_Vista.Models.Product
@{
    ViewData["Title"] = "Delete Product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<style>
    :root {
        --brand-yellow: #ebcd1e;
        --brand-black: #333;
    }

    .card-header-custom {
        background-color: #dc3545;
        color: white;
    }

    .btn-custom-delete {
        background-color: #dc3545;
        color: white;
        font-weight: bold;
    }

    .btn-custom-delete:hover {
        background-color: #c82333;
        color: white;
    }

    .product-preview {
        max-width: 300px;
        max-height: 200px;
        border: 2px solid #ddd;
        border-radius: 8px;
        margin: 1rem 0;
    }

    .info-section {
        background: #f8f9fa;
        padding: 1.5rem;
        border-radius: 10px;
        margin-bottom: 1.5rem;
        border-left: 4px solid #dc3545;
    }

    .info-section h5 {
        color: var(--brand-black);
        margin-bottom: 1rem;
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid #e9ecef;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        font-weight: bold;
        color: var(--brand-black);
    }

    .info-value {
        color: #666;
    }

    .warning-message {
        background: #fff3cd;
        border: 1px solid #ffeaa7;
        color: #856404;
        padding: 1rem;
        border-radius: 8px;
        margin-bottom: 1.5rem;
    }
</style>

<div class="page-content">
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Product Catalog</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Manage Products</a></li>
                    <li class="breadcrumb-item active">Delete Product</li>
                </ol>
            </nav>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header card-header-custom">
                    <h5 class="text-white mb-0">
                        <i class="fas fa-exclamation-triangle"></i> Delete Product Confirmation
                    </h5>
                </div>
                <div class="card-body">
                    <div class="warning-message">
                        <h6><i class="fas fa-exclamation-triangle"></i> Warning</h6>
                        <p class="mb-0">
                            You are about to delete the product "<strong>@Model.Name</strong>". 
                            This action cannot be undone and will permanently remove the product from the system.
                        </p>
                    </div>

                    <div class="row">
                        <div class="col-md-4">
                            @if (!string.IsNullOrEmpty(Model.MainImagePath))
                            {
                                <img src="@Model.MainImagePath" class="product-preview" alt="@Model.Name" />
                            }
                            else
                            {
                                <div class="product-preview d-flex align-items-center justify-content-center bg-light">
                                    <i class="fas fa-image text-muted" style="font-size: 3rem;"></i>
                                </div>
                            }
                        </div>
                        <div class="col-md-8">
                            <div class="info-section">
                                <h5><i class="fas fa-info-circle"></i> Product Information</h5>
                                
                                <div class="info-item">
                                    <span class="info-label">Product Name:</span>
                                    <span class="info-value">@Model.Name</span>
                                </div>
                                
                                <div class="info-item">
                                    <span class="info-label">Category:</span>
                                    <span class="info-value">@Model.Category</span>
                                </div>
                                
                                @if (!string.IsNullOrEmpty(Model.Brand))
                                {
                                    <div class="info-item">
                                        <span class="info-label">Brand:</span>
                                        <span class="info-value">@Model.Brand</span>
                                    </div>
                                }
                                
                                <div class="info-item">
                                    <span class="info-label">Price:</span>
                                    <span class="info-value">
                                        @if (Model.SalePrice.HasValue && Model.SalePrice < Model.Price)
                                        {
                                            <span class="text-decoration-line-through">$@Model.Price.ToString("N2")</span>
                                            <span class="text-danger ms-2">$@Model.SalePrice.Value.ToString("N2")</span>
                                        }
                                        else
                                        {
                                            <span>$@Model.Price.ToString("N2")</span>
                                        }
                                    </span>
                                </div>
                                
                                <div class="info-item">
                                    <span class="info-label">Stock Quantity:</span>
                                    <span class="info-value">@Model.StockQuantity</span>
                                </div>
                                
                                <div class="info-item">
                                    <span class="info-label">Status:</span>
                                    <span class="info-value">
                                        @if (Model.IsAvailable)
                                        {
                                            <span class="badge bg-success">Available</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Unavailable</span>
                                        }
                                    </span>
                                </div>
                                
                                @if (Model.IsFeatured)
                                {
                                    <div class="info-item">
                                        <span class="info-label">Featured:</span>
                                        <span class="info-value">
                                            <span class="badge bg-warning text-dark">Featured Product</span>
                                        </span>
                                    </div>
                                }
                                
                                <div class="info-item">
                                    <span class="info-label">Created:</span>
                                    <span class="info-value">@Model.CreatedAt.ToString("MMM dd, yyyy")</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.ShortDescription))
                    {
                        <div class="info-section">
                            <h5><i class="fas fa-align-left"></i> Description</h5>
                            <p class="mb-0">@Model.ShortDescription</p>
                        </div>
                    }

                    <div class="info-section">
                        <h5><i class="fas fa-exclamation-triangle text-danger"></i> What will be deleted?</h5>
                        <ul class="mb-0">
                            <li>Product information and details</li>
                            <li>Product images (main and additional)</li>
                            <li>All associated cart items</li>
                            <li>Product ratings and reviews</li>
                        </ul>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="ProductId" />
                        
                        <div class="text-center">
                            <button type="submit" class="btn btn-custom-delete px-5" onclick="return confirm('Are you absolutely sure you want to delete this product? This action cannot be undone.')">
                                <i class="fas fa-trash"></i> Delete Product
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary px-5 ms-2">
                                <i class="fas fa-times"></i> Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
