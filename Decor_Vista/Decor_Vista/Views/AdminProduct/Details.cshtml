@model Decor_Vista.Models.Product
@{
    ViewData["Title"] = Model.Name;
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/UserLayout/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/UserLayout/css/font-awesome.min.css">
    <link rel="stylesheet" href="~/UserLayout/css/elegant-font.css">
    <link rel="stylesheet" href="~/UserLayout/css/linearicons.css">
    <link rel="stylesheet" href="~/UserLayout/css/style.css">
    <link rel="stylesheet" href="~/UserLayout/switcher/demo.css" type="text/css">
    <link rel="stylesheet" href="~/UserLayout/switcher/colors/yellow.css" type="text/css" id="colors">

    <style>
        :root {
            --brand-yellow: #ebcd1e;
            --brand-black: #333;
        }

        .product-details-header {
            background: linear-gradient(135deg, var(--brand-black) 0%, #555 100%);
            color: white;
            padding: 2rem 0;
            margin-bottom: 3rem;
        }

        .product-gallery {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }

        .main-image {
            width: 100%;
            height: 500px;
            object-fit: cover;
            border-radius: 15px 15px 0 0;
        }

        .thumbnail-gallery {
            padding: 1rem;
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
        }

        .thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            cursor: pointer;
            border: 2px solid transparent;
            transition: all 0.3s ease;
        }

            .thumbnail:hover, .thumbnail.active {
                border-color: var(--brand-yellow);
                transform: scale(1.05);
            }

        .product-info-card {
            background: white;
            border-radius: 15px;
            padding: 2rem;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            margin-bottom: 2rem;
        }

        .product-title {
            color: var(--brand-black);
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 1rem;
        }

        .product-price {
            font-size: 2rem;
            font-weight: bold;
            color: var(--brand-black);
            margin-bottom: 1.5rem;
        }

        .price-original {
            text-decoration: line-through;
            color: #6c757d;
            font-size: 1.5rem;
            margin-right: 1rem;
        }

        .price-sale {
            color: #dc3545;
        }

        .product-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 0.5rem;
            margin-bottom: 1.5rem;
        }

        .meta-tag {
            background: var(--brand-yellow);
            color: var(--brand-black);
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .product-description {
            color: #666;
            line-height: 1.8;
            margin-bottom: 2rem;
        }

        .quantity-controls {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 2rem;
        }

        .quantity-btn {
            background: var(--brand-yellow);
            color: var(--brand-black);
            border: none;
            width: 40px;
            height: 40px;
            border-radius: 50%;
            font-weight: bold;
            font-size: 1.2rem;
            cursor: pointer;
            transition: all 0.3s ease;
        }

            .quantity-btn:hover {
                background: #d4b91a;
                transform: scale(1.1);
            }

        .quantity-input {
            width: 80px;
            text-align: center;
            border: 2px solid #e9ecef;
            border-radius: 8px;
            padding: 0.5rem;
            font-weight: bold;
        }

        .btn-main-color {
            background: var(--brand-yellow);
            color: var(--brand-black);
            border: none;
            font-weight: bold;
            padding: 1rem 2rem;
            border-radius: 25px;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            margin-right: 1rem;
        }

            .btn-main-color:hover {
                background: #d4b91a;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .btn-outline-secondary {
            border: 2px solid var(--brand-black);
            color: var(--brand-black);
            background: transparent;
            padding: 1rem 2rem;
            border-radius: 25px;
            font-weight: bold;
            transition: all 0.3s ease;
        }

            .btn-outline-secondary:hover {
                background: var(--brand-black);
                color: white;
            }

        .product-specs {
            background: #f8f9fa;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
        }

        .spec-item {
            display: flex;
            justify-content: space-between;
            padding: 0.75rem 0;
            border-bottom: 1px solid #e9ecef;
        }

            .spec-item:last-child {
                border-bottom: none;
            }

        .spec-label {
            font-weight: bold;
            color: var(--brand-black);
        }

        .spec-value {
            color: #666;
        }

        .purchase-link-section {
            background: #e8f5e8;
            border-radius: 15px;
            padding: 2rem;
            margin-bottom: 2rem;
            border-left: 4px solid #28a745;
        }

        .rating-section {
            display: flex;
            align-items: center;
            gap: 1rem;
            margin-bottom: 1.5rem;
        }

        .stars {
            color: var(--brand-yellow);
            font-size: 1.2rem;
        }

        .stock-status {
            padding: 0.5rem 1rem;
            border-radius: 20px;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .in-stock {
            background: #d4edda;
            color: #155724;
        }

        .out-of-stock {
            background: #f8d7da;
            color: #721c24;
        }

        .breadcrumb {
            background: transparent;
            padding: 0;
            margin-bottom: 1rem;
        }

        .breadcrumb-item a {
            color: var(--brand-yellow);
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: #6c757d;
        }

        .breadcrumb-item + .breadcrumb-item::before {
            content: ">";
            color: #6c757d;
        }

        .related-products {
            margin-top: 4rem;
        }

        .section-title {
            color: var(--brand-black);
            font-size: 2rem;
            font-weight: bold;
            margin-bottom: 2rem;
            text-align: center;
        }

        .product-item {
            background: white;
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 5px 20px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            margin-bottom: 2rem;
        }

            .product-item:hover {
                transform: translateY(-10px);
                box-shadow: 0 15px 40px rgba(0,0,0,0.2);
            }

        .products-warp img {
            width: 100%;
            height: 250px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .product-item:hover .products-warp img {
            transform: scale(1.1);
        }

        .product-info {
            padding: 1.5rem;
        }

            .product-info h3 {
                color: var(--brand-black);
                font-size: 1.1rem;
                margin-bottom: 0.5rem;
                font-weight: bold;
            }

                .product-info h3 a {
                    color: inherit;
                    text-decoration: none;
                }

                    .product-info h3 a:hover {
                        color: var(--brand-yellow);
                    }

        .price {
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--brand-black);
            margin-bottom: 1rem;
        }

        .btn-block {
            width: 100%;
        }
    </style>
}


<div class="page-content" style="margin-top: 20px;">
    <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
        <div class="breadcrumb-title pe-3">Product Catalog</div>
        <div class="ps-3">
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0 p-0">
                    <li class="breadcrumb-item"><a asp-action="Index">Manage Products</a></li>
                    <li class="breadcrumb-item active">@Model.Name</li>
                </ol>
            </nav>
        </div>
    </div>
</div>
<div class="container" style="margin-top: 50px;">
    <div class="row">
        <!-- Product Gallery -->
        <div class="col-lg-6">
            <div class="product-gallery">
                <img id="mainImage" src="@(string.IsNullOrEmpty(Model.MainImagePath) ? "/UserLayout/images/Shop/1.jpg" : Model.MainImagePath)"
                     class="main-image" alt="@Model.Name">

                @if (!string.IsNullOrEmpty(Model.AdditionalImagesPath))
                {
                    <div class="thumbnail-gallery">
                        <img src="@(string.IsNullOrEmpty(Model.MainImagePath) ? "/UserLayout/images/Shop/1.jpg" : Model.MainImagePath)"
                             class="thumbnail active" onclick="changeMainImage(this.src)" alt="@Model.Name">

                        @foreach (var imagePath in Model.AdditionalImagesPath.Split('|'))
                        {
                            <img src="@imagePath" class="thumbnail" onclick="changeMainImage(this.src)" alt="@Model.Name">
                        }
                    </div>
                }
            </div>
        </div>

        <!-- Product Information -->
        <div class="col-lg-6">
            <div class="product-info-card">
                <h1 class="product-title">@Model.Name</h1>

                <div class="product-meta">
                    <span class="meta-tag">@Model.Category</span>
                    @if (!string.IsNullOrEmpty(Model.Brand))
                    {
                        <span class="meta-tag">@Model.Brand</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Style))
                    {
                        <span class="meta-tag">@Model.Style</span>
                    }
                    @if (Model.IsFeatured)
                    {
                        <span class="meta-tag">Featured</span>
                    }
                </div>

                <div class="rating-section">
                    @if (Model.Rating.HasValue)
                    {
                        <div class="stars">
                            @for (int i = 1; i <= 5; i++)
                            {
                                if (i <= Model.Rating.Value)
                                {
                                    <i class="fa fa-star"></i>
                                }
                                else if ((decimal)(i - 0.5) <= Model.Rating.Value)
                                {
                                    <i class="fa fa-star-half-o"></i>
                                }
                                else
                                {
                                    <i class="fa fa-star-o"></i>
                                }
                            }
                        </div>
                        <span>@Model.Rating.Value.ToString("F1") / 5</span>
                        <span>(@Model.ReviewCount reviews)</span>
                    }
                    else
                    {
                        <span>No ratings yet</span>
                    }
                </div>

<div class="stock-status @(Model.StockQuantity > 0 ? "in-stock" : "out-of-stock")">
    @if (Model.StockQuantity > 0)
    {
        <i class="fa fa-check-circle"></i> @Model.StockQuantity @:in stock
    }
    else
    {
        <i class="fa fa-times-circle"></i> @:Out of stock
    }
</div>

                <div class="product-price mt-3">
                    @if (Model.SalePrice.HasValue && Model.SalePrice < Model.Price)
                    {
                        <span class="price-original">$@Model.Price.ToString("N2")</span>
                        <span class="price-sale">$@Model.SalePrice.Value.ToString("N2")</span>
                    }
                    else
                    {
                        <span>$@Model.Price.ToString("N2")</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.ShortDescription))
                {
                    <div class="product-description">
                        @Model.ShortDescription
                    </div>
                }

                <div class="d-flex flex-wrap">
                    <a href="@Url.Action("Edit", "AdminProduct", new { id = Model.ProductId })" class="btn btn-warning me-2">
                        <i class="fa fa-edit"></i> Edit Product
                    </a>
                    <a href="@Url.Action("Index", "AdminProduct")" class="btn btn-secondary me-2">
                        <i class="fa fa-arrow-left"></i> Back to Products
                    </a>
            
                </div>


            </div>
        </div>
    </div>

    <!-- Product Specifications -->
    <div class="row">
        <div class="col-12">
            <div class="product-specs">
                <h4 class="mb-3"><i class="fa fa-info-circle"></i> Product Specifications</h4>

                @if (!string.IsNullOrEmpty(Model.Dimensions))
                {
                    <div class="spec-item">
                        <span class="spec-label">Dimensions:</span>
                        <span class="spec-value">@Model.Dimensions</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Materials))
                {
                    <div class="spec-item">
                        <span class="spec-label">Materials:</span>
                        <span class="spec-value">@Model.Materials</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Color))
                {
                    <div class="spec-item">
                        <span class="spec-label">Color:</span>
                        <span class="spec-value">@Model.Color</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Style))
                {
                    <div class="spec-item">
                        <span class="spec-label">Style:</span>
                        <span class="spec-value">@Model.Style</span>
                    </div>
                }

                @if (Model.Weight.HasValue)
                {
                    <div class="spec-item">
                        <span class="spec-label">Weight:</span>
                        <span class="spec-value">@Model.Weight.Value kg</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.SKU))
                {
                    <div class="spec-item">
                        <span class="spec-label">SKU:</span>
                        <span class="spec-value">@Model.SKU</span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Tags))
                {
                    <div class="spec-item">
                        <span class="spec-label">Tags:</span>
                        <span class="spec-value">@Model.Tags</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Detailed Description -->
    @if (!string.IsNullOrEmpty(Model.DetailedDescription))
    {
        <div class="row">
            <div class="col-12">
                <div class="product-info-card">
                    <h4 class="mb-3"><i class="fa fa-align-left"></i> Detailed Description</h4>
                    <div class="product-description">
                        @Model.DetailedDescription
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/UserLayout/js/jquery-3.6.0.min.js"></script>
    <script src="~/UserLayout/js/bootstrap.min.js"></script>

    <script>
        function changeMainImage(src) {
            document.getElementById('mainImage').src = src;

            // Update active thumbnail
            document.querySelectorAll('.thumbnail').forEach(thumb => {
                thumb.classList.remove('active');
            });
            event.target.classList.add('active');
        }

        

        
    </script>
}