@model Decor_Vista.Models.Product
@{
    ViewData["Title"] = $"{Model?.Name} - Decor Vista";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@Html.AntiForgeryToken()

@section Styles {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">

    <style>
        :root {
            --brand-primary: #ebcd1e; /* Elegant gold */
            --brand-secondary: #1a1814; /* Rich black */
            --brand-light-grey: #f8f9fa;
            --brand-grey: #6c757d;
            --brand-white: #ffffff;
            --brand-success: #28a745;
            --brand-danger: #dc3545;
            --font-family-base: 'Poppins', sans-serif;
        }

        body {
            font-family: var(--font-family-base);
            background-color: #fdfdfd;
        }

        /* --- Main Product Details Container --- */
        .product-details-section {
            padding: 4rem 0;
        }

        .product-details-container {
            display: flex;
            flex-wrap: wrap;
            gap: 3rem;
        }

        .product-image-column {
            flex: 1;
            min-width: 300px;
        }

        .product-info-column {
            flex: 1;
            min-width: 300px;
        }

        .product-main-image {
            width: 100%;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            object-fit: cover;
        }

        /* --- Product Info Styling --- */
        .product-title {
            font-size: 2.5rem;
            font-weight: 700;
            color: var(--brand-secondary);
            line-height: 1.2;
            margin-bottom: 0.5rem;
        }

        .product-sku {
            font-size: 0.9rem;
            color: var(--brand-grey);
            margin-bottom: 1.5rem;
        }

        .price-section {
            font-size: 2rem;
            font-weight: 600;
            color: var(--brand-secondary);
            margin-bottom: 1rem;
        }

            .price-section .old-price {
                text-decoration: line-through;
                color: var(--brand-grey);
                font-size: 1.25rem;
                margin-right: 0.75rem;
                font-weight: 400;
            }

            .price-section .sale-price {
                color: var(--brand-danger);
            }

        .product-short-description {
            font-size: 1rem;
            color: #555;
            line-height: 1.6;
            margin: 1.5rem 0;
            border-left: 3px solid var(--brand-primary);
            padding-left: 1.5rem;
        }

        /* --- CTA Section: Quantity & Button --- */
        .cta-section {
            background: var(--brand-light-grey);
            border-radius: 15px;
            padding: 1.5rem;
            margin: 2rem 0;
        }

        .quantity-selector {
            display: flex;
            align-items: center;
            margin-bottom: 1.5rem;
            gap: 0.5rem;
        }

            .quantity-selector label {
                font-weight: 600;
                color: var(--brand-secondary);
                margin-right: 1rem;
            }

        .quantity-btn {
            background-color: #e9ecef;
            border: none;
            width: 40px;
            height: 40px;
            font-size: 1.2rem;
            font-weight: bold;
            border-radius: 50%;
            cursor: pointer;
            transition: background-color 0.3s;
        }

            .quantity-btn:hover {
                background-color: #ced4da;
            }

        #quantity {
            width: 60px;
            height: 40px;
            text-align: center;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-weight: 600;
            font-size: 1.1rem;
            -moz-appearance: textfield; /* Firefox */
        }

            #quantity::-webkit-outer-spin-button,
            #quantity::-webkit-inner-spin-button {
                -webkit-appearance: none;
                margin: 0;
            }

        .btn-add-to-cart {
            width: 100%;
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 600;
            background-color: var(--brand-primary);
            color: var(--brand-white);
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
        }

            .btn-add-to-cart:hover {
                background-color: var(--brand-secondary);
                transform: translateY(-3px);
                box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            }

            .btn-add-to-cart:disabled {
                background-color: var(--brand-grey);
                cursor: not-allowed;
                transform: none;
                box-shadow: none;
            }

        .stock-status {
            font-weight: 500;
            margin-top: 1rem;
            text-align: center;
        }

            .stock-status.in-stock {
                color: var(--brand-success);
            }

            .stock-status.out-of-stock {
                color: var(--brand-danger);
            }

        /* --- Meta & Description --- */
        .product-meta-section, .product-description-section {
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid #eee;
        }

            .product-meta-section h4, .product-description-section h4 {
                font-weight: 600;
                color: var(--brand-secondary);
                margin-bottom: 1rem;
            }

        .meta-item {
            display: flex;
            justify-content: space-between;
            padding: 0.5rem 0;
            font-size: 0.95rem;
        }

            .meta-item span:first-child {
                font-weight: 600;
                color: var(--brand-secondary);
            }

            .meta-item span:last-child {
                color: #555;
            }

        .product-tags {
            margin-top: 1.5rem;
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 0.5rem;
        }

            .product-tags .tag-label {
                font-weight: 600;
                color: var(--brand-secondary);
            }

            .product-tags a {
                background-color: #e9ecef;
                color: #555;
                padding: 0.25rem 0.75rem;
                border-radius: 20px;
                text-decoration: none;
                font-size: 0.85rem;
                transition: all 0.3s;
            }

                .product-tags a:hover {
                    background-color: var(--brand-primary);
                    color: var(--brand-white);
                }

        /* --- Features Section --- */
        .features-section {
            background-color: var(--brand-light-grey);
            padding: 4rem 0;
            margin-top: 3rem;
        }

        .features-container {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            text-align: center;
        }

        .feature-item {
            padding: 2rem;
        }

            .feature-item i {
                font-size: 2.5rem;
                color: var(--brand-primary);
                margin-bottom: 1rem;
            }

            .feature-item h4 {
                font-weight: 600;
                color: var(--brand-secondary);
            }

            .feature-item p {
                color: #555;
                font-size: 0.9rem;
            }

        .product-details-section{
            margin-top:100px;
        }
    </style>
}

<section class="product-details-section mt-5">
    <div class="container">
        <div class="product-details-container">
            <!-- Product Image -->
            <div class="product-image-column">
                @if (!string.IsNullOrEmpty(Model?.MainImagePath))
                {
                    <img alt="@Model.Name" src="@Model.MainImagePath" class="product-main-image">
                }
                else
                {
                    <img alt="@Model?.Name" src="~/UserLayout/images/Shop/shop-thumb-1.jpg" class="product-main-image">
                }
            </div>

            <!-- Product Information -->
            <div class="product-info-column">
                <h1 class="product-title">@Model?.Name</h1>

                @if (!string.IsNullOrEmpty(Model?.SKU))
                {
                    <p class="product-sku">SKU: @Model.SKU</p>
                }

                <div class="price-section">
                    @if (Model?.SalePrice.HasValue == true && Model.SalePrice < Model.Price)
                    {
                        <span class="old-price">$@Model.Price.ToString("F2")</span>
                        <span class="sale-price">$@Model.SalePrice.Value.ToString("F2")</span>
                    }
                    else
                    {
                        <span>$@Model?.Price.ToString("F2")</span>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model?.ShortDescription))
                {
                    <p class="product-short-description">@Model.ShortDescription</p>
                }

                <!-- CTA Section (Quantity and Add to Cart) -->
                <div class="cta-section">
                    @if (Model?.IsAvailable == true && Model.StockQuantity > 0)
                    {
                        <div class="quantity-selector">
                            <label for="quantity">Quantity:</label>
                            <button class="quantity-btn" id="quantity-minus" type="button">-</button>
                            <input type="number" id="quantity" class="input-text qty text" value="1" name="quantity" min="1" max="@Model.StockQuantity" step="1">
                            <button class="quantity-btn" id="quantity-plus" type="button">+</button>
                        </div>
                        <button class="btn-add-to-cart" data-product-id="@Model.ProductId">
                            <i class="fas fa-shopping-cart"></i> Add to Cart
                        </button>
                        <p class="stock-status in-stock">
                            <i class="fas fa-check-circle"></i> In Stock: @Model.StockQuantity available
                        </p>
                    }
                    else
                    {
                        <button class="btn-add-to-cart" disabled>
                            <i class="fas fa-times-circle"></i> Out of Stock
                        </button>
                        <p class="stock-status out-of-stock">Currently unavailable</p>
                    }
                </div>

                <!-- Meta Information -->
                @if (!string.IsNullOrEmpty(Model?.Brand) || !string.IsNullOrEmpty(Model?.Style) || !string.IsNullOrEmpty(Model?.Color))
                {
                    <div class="product-meta-section">
                        <h4>Details</h4>
                        @if (!string.IsNullOrEmpty(Model?.Category))
                        {
                            <div class="meta-item">
                                <span>Category:</span> <span>@Model.Category</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Brand))
                        {
                            <div class="meta-item">
                                <span>Brand:</span> <span>@Model.Brand</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Style))
                        {
                            <div class="meta-item">
                                <span>Style:</span> <span>@Model.Style</span>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Model?.Color))
                        {
                            <div class="meta-item">
                                <span>Color:</span> <span>@Model.Color</span>
                            </div>
                        }
                    </div>
                }

                <!-- Detailed Description -->
                @if (!string.IsNullOrEmpty(Model?.DetailedDescription))
                {
                    <div class="product-description-section">
                        <h4>Description</h4>
                        <div>@Html.Raw(Model.DetailedDescription)</div>
                    </div>
                }

                <!-- Tags -->
                @if (!string.IsNullOrEmpty(Model?.Tags))
                {
                    <div class="product-tags">
                        <span class="tag-label">Tags:</span>
                        @foreach (var tag in Model.Tags.Split(','))
                        {
                            <a href="@Url.Action("Catalog", "Product", new { search = tag.Trim() })">@tag.Trim()</a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-section">
    <div class="container">
        <div class="features-container">
            <div class="feature-item">
                <i class="fas fa-undo-alt"></i>
                <h4>30-Day Money Back</h4>
                <p>Not satisfied? Return your purchase for a full refund.</p>
            </div>
            <div class="feature-item">
                <i class="fas fa-truck"></i>
                <h4>Free Shipping</h4>
                <p>On all orders over $100 within the continental US.</p>
            </div>
            <div class="feature-item">
                <i class="fas fa-shield-alt"></i>
                <h4>Secure Payments</h4>
                <p>Your payment information is safe and secure with us.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {

            // --- Custom Quantity Selector Logic ---
            const quantityInput = document.getElementById('quantity');
            const plusBtn = document.getElementById('quantity-plus');
            const minusBtn = document.getElementById('quantity-minus');

            if (quantityInput) {
                const maxQuantity = parseInt(quantityInput.max, 10);
                const minQuantity = parseInt(quantityInput.min, 10);

                plusBtn.addEventListener('click', () => {
                    let currentValue = parseInt(quantityInput.value, 10);
                    if (currentValue < maxQuantity) {
                        quantityInput.value = currentValue + 1;
                    }
                });

                minusBtn.addEventListener('click', () => {
                    let currentValue = parseInt(quantityInput.value, 10);
                    if (currentValue > minQuantity) {
                        quantityInput.value = currentValue - 1;
                    }
                });
            }

            // --- Add to Cart Logic ---
            const addToCartButton = document.querySelector('.btn-add-to-cart');

            if (addToCartButton && !addToCartButton.disabled) {
                addToCartButton.addEventListener('click', function() {
                    const productId = this.getAttribute('data-product-id');
                    const quantity = document.getElementById('quantity').value;

                    if (quantity && !isNaN(quantity) && parseInt(quantity) > 0) {
                        sendToCart(productId, parseInt(quantity));
                    } else {
                        showToast('Please enter a valid quantity.', 'danger');
                    }
                });
            }

            function sendToCart(productId, quantity) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

                fetch('@Url.Action("AddToCart", "Product")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': token
                    },
                    body: `productId=${productId}&quantity=${quantity}`
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showToast(data.message, 'success');
                        // You can add more functionality here, like updating a mini-cart
                    } else {
                        showToast(data.message, 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showToast('An error occurred while adding to cart.', 'danger');
                });
            }

            // --- Toast Notification Function ---
            function showToast(message, type = 'success') {
                const toastContainer = document.createElement('div');
                toastContainer.style.position = 'fixed';
                toastContainer.style.top = '20px';
                toastContainer.style.right = '20px';
                toastContainer.style.zIndex = '1055';

                const toast = document.createElement('div');
                toast.className = `toast align-items-center text-white bg-${type === 'success' ? 'success' : 'danger'} border-0 show`;
                toast.setAttribute('role', 'alert');
                toast.setAttribute('aria-live', 'assertive');
                toast.setAttribute('aria-atomic', 'true');

                toast.innerHTML = `
                    <div class="d-flex">
                        <div class="toast-body">
                            ${message}
                        </div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                    </div>
                `;

                toastContainer.appendChild(toast);
                document.body.appendChild(toastContainer);

                const bsToast = new bootstrap.Toast(toast, { delay: 3000 });
                bsToast.show();

                toast.addEventListener('hidden.bs.toast', function() {
                    document.body.removeChild(toastContainer);
                });
            }
        });
    </script>
}