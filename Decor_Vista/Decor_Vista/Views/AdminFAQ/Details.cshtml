@model Decor_Vista.Models.FAQ

@{
    ViewData["Title"] = "FAQ Details";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<style>
    /* Custom Color Theme Variables */
    :root {
        --brand-yellow: #ebcd1e;
        --brand-black: #333;
    }

    /* Profile Card on the Left */
    .details-profile-card {
        background: linear-gradient(135deg, #434343 0%, #000000 100%);
        color: white;
        border: none;
        text-align: center;
        padding: 2rem;
    }

        .details-profile-card img {
            width: 130px;
            height: 130px;
            object-fit: cover;
            border-radius: 50%;
            border: 4px solid var(--brand-yellow);
        }

        .details-profile-card .admin-name {
            color: var(--brand-yellow);
            font-weight: 600;
            margin-top: 1rem;
        }

        .details-profile-card .admin-email {
            font-size: 0.9rem;
            color: #ddd;
        }

    /* Details Card on the Right */
    .details-info-card .card-header {
        background-color: var(--brand-black);
        color: var(--brand-yellow);
    }

    .details-info-card dt {
        font-weight: 600;
        color: var(--brand-black);
    }

    .details-info-card dd {
        color: #555;
    }

    /* Action Buttons */
    .btn-custom-edit {
        background-color: var(--brand-yellow);
        color: var(--brand-black);
        font-weight: bold;
        border: none;
    }

        .btn-custom-edit:hover {
            background-color: #d4b91a;
            color: var(--brand-black);
        }
</style>
<div class="page-content">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h4 class="card-title mb-0">FAQ Details</h4>
                    <div>
                        <a href="@Url.Action("Edit", "AdminFAQ", new { id = Model.Id })" class="btn btn-warning">
                            <i class="material-icons-outlined">edit</i> Edit
                        </a>
                        <a href="@Url.Action("Index", "AdminFAQ")" class="btn btn-secondary">
                            <i class="material-icons-outlined">arrow_back</i> Back to List
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-8">
                            <div class="mb-4">
                                <h5 class="text-primary">Question:</h5>
                                <p class="fs-5">@Model.Question</p>
                            </div>

                            <div class="mb-4">
                                <h5 class="text-primary">Answer:</h5>
                                <div class="bg-light p-3 rounded">
                                    @Html.Raw(Model.Answer.Replace("\n", "<br>"))
                                </div>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="card bg-light">
                                <div class="card-body">
                                    <h6 class="card-title">FAQ Information</h6>
                                    
                                    <div class="mb-3">
                                        <strong>ID:</strong> @Model.Id
                                    </div>
                                    
                                    <div class="mb-3">
                                        <strong>Status:</strong>
                                        @if (Model.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </div>
                                    
                                    <div class="mb-3">
                                        <strong>Created:</strong><br>
                                        @Model.CreatedAt.ToString("MMM dd, yyyy 'at' HH:mm")
                                    </div>
                                    
                                    <div class="mb-3">
                                        <strong>Last Updated:</strong><br>
                                        @Model.UpdatedAt.ToString("MMM dd, yyyy 'at' HH:mm")
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
