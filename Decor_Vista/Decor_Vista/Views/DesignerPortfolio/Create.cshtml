@model Decor_Vista.Models.Portfolio
@{
    ViewData["Title"] = "Designer | Portfolio - Create";
    Layout = "../Shared/_DesignerLayout.cshtml";
}
<style>
    :root {
        --brand-yellow: #ebcd1e;
        --brand-black: #333;
    }

    .card-header-custom {
        background-color: var(--brand-black);
        color: var(--brand-yellow);
    }

    .btn-custom-create {
        background-color: var(--brand-yellow);
        color: var(--brand-black);
        font-weight: bold;
    }
</style>
<div class="main-content">
    <!--end sidebar-->
    <div class="container-fluid">
        <main role="main" class="pb-3">
            <div class="page-content">
                <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
                    <div class="breadcrumb-title pe-3">My Portfolio</div>
                    <div class="ps-3">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0 p-0">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "DesignerPortfolio")">All Portfolio</a></li>
                                <li class="breadcrumb-item active" aria-current="page">Create New Portfolio</li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header card-header-custom"><h5 class="text-white">Create New Portfolio</h5></div>
                            <div class="card-body p-4">
                                <form asp-action="Create" method="post" enctype="multipart/form-data">
                                    @Html.AntiForgeryToken()
                                    <div class="row">
                                        <div class="col-md-6 mb-3"><label asp-for="Title"></label><input asp-for="Title" class="form-control" /><span asp-validation-for="Title" class="text-danger"></span></div>
                                        <div class="col-md-6 mb-3">
                                            <label>Category</label>
                                            <select asp-for="CategoryId" class="form-select">
                                                <option value="">-- Select Category --</option>
                                                @foreach (var c in ViewBag.Categories)
                                                {
                                                    <option value="@c.CategoryId">@c.CategoryName</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-md-12 mb-3"><label asp-for="Description"></label> <textarea asp-for="Description" class="form-control" rows="5"></textarea> <span asp-validation-for="Description" class="text-danger"></span> </div>
                                        <div class="col-md-6 mb-3">
                                            <label>Main Image</label>
                                            <input type="file" name="MainImage" class="form-control" />
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <label>Additional Images</label>
                                            <input type="file" name="AdditionalImages" class="form-control" multiple />
                                        </div>
                                        <div class="col-md-12 mb-3">
                                            <label>Project Link</label>
                                            <input asp-for="ProjectLink" class="form-control" />
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-custom-create">Create</button>
                                    <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>