@model Decor_Vista.Models.Portfolio
@{
    ViewData["Title"] = "Designer | Portfolio - Manage Images";
    Layout = "../Shared/_DesignerLayout.cshtml";
}
<style>
    :root {
        --brand-yellow: #ebcd1e;
        --brand-black: #333;
    }

    .card-header-custom {
        background-color: var(--brand-black);
        color: var(--brand-yellow);
    }

    .btn-custom-create {
        background-color: var(--brand-yellow);
        color: var(--brand-black);
        font-weight: bold;
    }
</style>
<div class="main-content">
    <!--end sidebar-->
    <div class="container-fluid">
        <main role="main" class="pb-3">
            <div class="page-content">
                <div class="page-breadcrumb d-none d-sm-flex align-items-center mb-3">
                    <div class="breadcrumb-title pe-3">Designer</div>
                    <div class="ps-3">
                        <nav aria-label="breadcrumb">
                            <ol class="breadcrumb mb-0 p-0">
                                <li class="breadcrumb-item"><a href="@Url.Action("Index", "DesignerPortfolio")">My Portfolios</a></li>
                                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
                            </ol>
                        </nav>
                    </div>
                </div>
                <div class="row justify-content-center">
                    <div class="col-lg-8">
                        <div class="card">
                            <div class="card-header card-header-custom"><h5 class="text-white">Manage @Model.Title Images</h5></div>
                            <div class="card-body p-4">
                                <form asp-action="AddImages" method="post" enctype="multipart/form-data">
                                    <input type="hidden" name="id" value="@Model.PortfolioId" />
                                    <div class="mb-3">
                                        <label>Add More Images</label>
                                        <input type="file" name="AdditionalImages" class="form-control" multiple />
                                    </div>
                                    <button type="submit" class="btn btn-primary">Upload</button>
                                </form>
                            </div>
                        </div>
                        <div class="card">
                            <div class="card-header card-header-custom"><h5 class="text-white">Existing Images</h5></div>
                            <div class="card-body p-4">
                                <div class="row">
                                    @foreach (var img in Model.Images)
                                    {
                                        <div class="col-md-3 text-center mb-3">
                                            <img src="@img.ImagePath" class="img-fluid mb-2" />
                                            <form asp-action="DeleteImage" method="post">
                                                <input type="hidden" name="imageId" value="@img.PortfolioImageId" />
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </main>
    </div>
</div>